{
  "name": "waveview",
  "version": "1.0.0",
  "description": "Waveform viewer for SPICE simulation files",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc && electron .\"",
    "dev:vite": "vite",
    "dev:electron": "tsc && electron .",
    "build": "vite build && tsc && electron-builder",
    "build:vite": "vite build",
    "build:electron": "tsc && electron-builder",
    "preview": "vite preview"
  },
  "keywords": ["waveform", "spice", "viewer"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "antd": "^5.0.0",
    "plotly.js-dist-min": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-plotly.js": "^2.6.0",
    "zustand": "^4.0.0"
  },
  "build": {
    "appId": "com.waveview.app",
    "productName": "WaveView",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
